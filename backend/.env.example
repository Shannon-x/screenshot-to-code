# API Keys (Required for core functionality)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom OpenAI-compatible API endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Image generation
# REPLICATE_API_KEY=your_replicate_api_key_here

# Development/Debugging
MOCK=false
IS_DEBUG_ENABLED=false
# DEBUG_DIR=/path/to/debug/directory

# Production settings
IS_PROD=false

# CORS Security Configuration
# For production, set specific allowed origins (comma-separated)
# Example: ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# Default allows common localhost ports for development
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Only set to true in development if you need to test from different origins
# ALLOW_ALL_ORIGINS=false

# Security: Encryption key for secure API key storage
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=your-encryption-key-here

# Rate limiting (optional, requires implementation)
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=300

# Session configuration (optional, for future auth implementation)
# SESSION_SECRET_KEY=your-secret-key-here-min-32-chars
# SESSION_EXPIRE_MINUTES=1440